# PostgreSQL (docker-compose)
# L'application se connecte avec un compte limité, soumis à la RLS (SEC-05, créé par les migrations).
DATABASE_URL=postgres://expense_app_login:expense_app@localhost:5433/expense_io
# Compte administrateur : migrations et seed uniquement.
DATABASE_ADMIN_URL=postgres://expense:expense@localhost:5433/expense_io

# Auth.js — secret de signature des sessions (32 caractères minimum).
# `make env` en génère un. Vide ou laissé à une valeur publique : l'app génère un secret aléatoire à chaque
# démarrage (sessions perdues au redémarrage). En production : openssl rand -hex 32
AUTH_SECRET=

# Jeton pour GET /metrics (T-0021). Vide : route ouverte en développement seulement, fermée (401) en production.
# Renseigné : Prometheus envoie « Authorization: Bearer <jeton> ».
METRICS_TOKEN=

# Umami (T-0028), facultatif : mesure d'usage des fonctionnalités dans l'interface, sans cookie.
# Les deux vides : suivi désactivé. URL du script en https et identifiant du site (UUID) donnés par Umami.
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=
# Requis uniquement en production (`next start`/`npm run start`).
# AUTH_TRUST_HOST=true

# Stockage objet S3-compatible (LocalStack en local, docker-compose)
S3_ENDPOINT=http://localhost:4567
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_BUCKET=receipts
S3_FORCE_PATH_STYLE=true
